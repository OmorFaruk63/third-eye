<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Calculator Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCalcEquation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#757575"
            android:textSize="20sp"
            android:singleLine="true"
            tools:text="125 + 75" />

        <TextView
            android:id="@+id/tvCalcDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:singleLine="true"
            tools:text="200" />
    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="true">

        <!-- Row 1: C, +/-, %, / -->
        <Button
            android:id="@+id/btnCalcClear"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#2C2C2C"
            android:text="C"
            android:textColor="#FF5252"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalcPlusMinus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#2C2C2C"
            android:text="+/-"
            android:textColor="#00E5FF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnCalcPercent"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#2C2C2C"
            android:text="%"
            android:textColor="#00E5FF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalcDivide"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#FF9800"
            android:text="÷"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <!-- Row 2: 7, 8, 9, * -->
        <Button
            android:id="@+id/btnCalc7"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalc8"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="8"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalc9"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="9"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalcMultiply"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#FF9800"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <!-- Row 3: 4, 5, 6, - -->
        <Button
            android:id="@+id/btnCalc4"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalc5"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalc6"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="6"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalcMinus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#FF9800"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <!-- Row 4: 1, 2, 3, + -->
        <Button
            android:id="@+id/btnCalc1"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalc2"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalc3"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalcPlus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#FF9800"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <!-- Row 5: 0, ., = (equal spans 2 columns or regular) -->
        <Button
            android:id="@+id/btnCalc0"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:backgroundTint="#1E1E1E"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnCalcDot"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#1E1E1E"
            android:text="."
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnCalcEqual"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:backgroundTint="#00E676"
            android:text="="
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

    </GridLayout>

</LinearLayout>
